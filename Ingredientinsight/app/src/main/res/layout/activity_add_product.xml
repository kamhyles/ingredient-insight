<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DADDD8">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_add_product"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Add Product" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Product name" />

            <EditText
                android:id="@+id/editProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:hint="e.g. Cheesy Snack Mix"
                android:paddingBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingredients" />

            <EditText
                android:id="@+id/editIngredients"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:inputType="textMultiLine"
                android:gravity="top"
                android:hint="Enter ingredients here..."
                android:paddingBottom="12dp" />

            <Button
                android:id="@+id/buttonScanFromGallery"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Scan label from gallery"
                android:textColor="@color/ebony"
                android:backgroundTint="#C7D59F"
                android:layout_marginTop="16dp"
                android:padding="12dp"
                android:radius="24dp"
                app:cornerRadius="24dp"/>

            <Button
                android:id="@+id/buttonScanFromCamera"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Scan label with Camera"
                android:textColor="@color/ebony"
                android:backgroundTint="#C7D59F"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                app:cornerRadius="24dp"/>

            <Button
                android:id="@+id/buttonSaveProduct"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Save Product"
                android:textColor="@android:color/white"
                android:backgroundTint="#8FB339"
                android:layout_marginTop="24dp"
                android:padding="12dp"
                app:cornerRadius="24dp"/>


        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

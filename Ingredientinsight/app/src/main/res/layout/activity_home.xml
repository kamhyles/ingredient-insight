<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alabasterGrey">


    <LinearLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:layout_above="@+id/fabAddProduct">

        <!-- greeting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/textGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello, User"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/ebony" />

            <TextView
                android:id="@+id/textGreetingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Here are your scanned products"
                android:textSize="14sp"
                android:textColor="@color/ebony"
                android:alpha="0.7" />
        </LinearLayout>

        <!-- filter tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="All"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/filter_tab_selected"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabBetter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Better choices"
                    android:textColor="@color/ebony"
                    android:background="@drawable/filter_tab_unselected"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabModeration"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Moderation"
                    android:textColor="@color/ebony"
                    android:background="@drawable/filter_tab_unselected"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabLessHealthy"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Less healthy"
                    android:textColor="@color/ebony"
                    android:background="@drawable/filter_tab_unselected" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- on empty state -->
        <TextView
            android:id="@+id/textEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No products yet. Tap + to scan a label."
            android:gravity="center"
            android:paddingTop="40dp"
            android:textColor="@color/ebony"
            android:alpha="0.6"
            android:visibility="gone" />

        <!-- product list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProducts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- add product button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:contentDescription="Add product"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="@android:color/white"
        app:backgroundTint="@color/limeMoss" />

</RelativeLayout>
